{
  "name": "ytmusic-linux-desktop",
  "version": "0.3.1",
  "description": "An unofficial, lightweight and security-conscious YouTube Music desktop client for Linux.",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "bartualperen",
    "email": "bartualperen@users.noreply.github.com"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:deb": "electron-builder --linux deb",
    "dist:appimage": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.github.bartualperen.ytmusiclinuxdesktop",
    "productName": "YTM Linux Desktop",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "PRIVACY.md",
      "SECURITY.md"
    ],
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "ytm-linux-desktop",
      "synopsis": "Unofficial YouTube Music desktop client for Linux",
      "description": "A lightweight and security-conscious unofficial YouTube Music desktop client for Linux.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "bartualperen <bartualperen@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "artifactName": "YTM-Linux-Desktop-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  },
  "homepage": "https://github.com/bartualperen/ytmusic-linux-desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartualperen/ytmusic-linux-desktop.git"
  },
  "desktopName": "com.github.bartualperen.ytmusiclinuxdesktop.desktop"
}
